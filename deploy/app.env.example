# Copy to RELEASE_ROOT/config/app.env on the server and chmod 600.
# Never place this file inside the public document root.
IJ26_APP_ENV=staging
IJ26_APP_URL=https://staging-indrajatra.newaguthi.org.au
IJ26_DB_HOST=localhost
IJ26_DB_PORT=3306
IJ26_DB_NAME=replace_me
IJ26_DB_USER=replace_me
IJ26_DB_PASSWORD=replace_me
IJ26_SESSION_SECRET=replace_with_at_least_32_random_characters
IJ26_MAIL_FROM=no-reply@newaguthi.org.au
IJ26_MAIL_FROM_NAME=Indra Jatra Melbourne
IJ26_MAILCHIMP_TRANSACTIONAL_KEY=
IJ26_AUTH_DEBUG_CODE=0
IJ26_ORGANISER_EMAILS=organiser@example.com
